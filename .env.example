# === NASPilot 环境变量 ===
# 复制此文件为 .env 并修改

# 签名密钥：一般不用设置，首次启动会自动生成并保存到 data/secret_key。
# 仅当你想自己管理（例如多实例共享同一密钥）时才需要取消注释：
# SECRET_KEY=改成至少 16 位的随机字符串

# 管理员初始密码（仅首次建库时生效；留空则随机生成并写入日志）
FIRST_ADMIN_PASSWORD=admin123

# 数据库路径：默认 /app/data/naspilot.db，一般不用设置
# DATABASE_URL=sqlite+aiosqlite:////app/data/naspilot.db

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 时区
TZ=Asia/Shanghai

# === 媒体下载中心（Media Download Center）===
# 媒体目录在 data/media（容器内 /app/data/media），其下自动派生 Video/ 与 Audio/

# 英语学习：默认直接复用媒体库（data/media），无需设置。
# ENGLISH_ROOT=      # 留空 = 复用媒体库
# 自动扫描：媒体库里一出现新课时（下载 / 拷贝 / rsync 都算）就自动入库并完成
# 难度、话题、技能、形式分类。0 = 关闭自动扫描（仍可用界面上的「扫描媒体库」）。
ENGLISH_AUTO_SCAN_SECONDS=60
# 每次同步最多下载的新条目数（保护磁盘）
MEDIA_MAX_PER_SYNC=20
# 每次扫描的条目上限
MEDIA_SCAN_LIMIT=100
# 默认最高分辨率（0 = 不限，取最佳画质）；单个订阅可覆盖
MEDIA_DEFAULT_VIDEO_HEIGHT=480
# 同时下载数
MEDIA_MAX_CONCURRENT=2
# 字幕语言
MEDIA_SUB_LANGS=en.*
# 音频格式：mp3（有损，兼容最好）| best（零转码保留原始音轨）| opus | m4a | flac | wav
MEDIA_AUDIO_FORMAT=mp3
# 有损编码质量（0 = 最高）；copy 模式下自动忽略
MEDIA_AUDIO_QUALITY=0
# 可选：cookies（年龄限制 / 需要登录的来源）
# MEDIA_COOKIES_FILE=/app/data/cookies.txt
# 可选：全局代理；也可在单个订阅里单独设置出网方式
# MEDIA_PROXY_URL=http://192.168.1.10:7890
# 可选：yt-dlp 的 JS 运行时（部分来源的签名需要 node 或 deno）
# MEDIA_JS_RUNTIMES=node

# 媒体服务器（可选，仅用于「历史记录 → 在 Emby/Jellyfin 打开」的跳转按钮）
# EMBY_URL=http://192.168.1.10:8096
# JELLYFIN_URL=http://192.168.1.10:8096
# AUDIOBOOKSHELF_URL=http://192.168.1.10:13378
