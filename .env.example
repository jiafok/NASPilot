# === NASPilot 环境变量 ===
# 复制此文件为 .env 并修改

# 安全密钥（生产环境务必修改！）
SECRET_KEY=change-me-to-a-random-string-at-least-32-chars

# 管理员初始密码（首次启动时创建，之后无效）
ADMIN_PASSWORD=admin123

# 数据库路径
DATABASE_URL=sqlite+aiosqlite:////app/data/naspilot.db

# 日志级别: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# 时区
TZ=Asia/Shanghai

# === 媒体订阅中心（YouTube 自动下载）===
# docker-compose 宿主机目录（容器内固定为 /media/Youtube 与 /media/Audio）
NAS_MEDIA_VIDEO=./data/media/Youtube
NAS_MEDIA_AUDIO=./data/media/Audio
# 自动检查间隔（小时）
YOUTUBE_SYNC_INTERVAL_HOURS=6
# 每次同步最多下载的新视频数（保护磁盘）
YOUTUBE_MAX_PER_SYNC=20
# 每次扫描的条目上限
YOUTUBE_SCAN_LIMIT=100
# 字幕语言 / 最高分辨率（0 = 不限，取最佳画质）
YOUTUBE_SUB_LANGS=en.*
YOUTUBE_MAX_HEIGHT=480
# 音频格式：mp3（有损，兼容最好）| best（零转码保留原始音轨）| opus | m4a | flac | wav
YOUTUBE_AUDIO_FORMAT=mp3
# 有损编码质量（0 = 最高）；copy 模式下自动忽略
YOUTUBE_AUDIO_QUALITY=0
# 可选：cookies（年龄限制 / 需要登录的视频）
# YOUTUBE_COOKIES_FILE=/app/data/cookies.txt
# 可选：代理
# YOUTUBE_PROXY=
# 可选：yt-dlp 的 JS 运行时（新版 YouTube 提取建议 node 或 deno）
# YOUTUBE_JS_RUNTIMES=node

# === 媒体下载中心（统一订阅平台）===
MEDIA_VIDEO_DIR=/Media/Video
MEDIA_AUDIO_DIR=/Media/Audio
MEDIA_DEFAULT_VIDEO_HEIGHT=480
MEDIA_MAX_CONCURRENT=2
MEDIA_MAX_PER_SYNC=20
MEDIA_SCAN_LIMIT=100
# 全局默认代理（订阅 network_mode=system 时生效）
# MEDIA_PROXY_URL=http://host.docker.internal:7890
# 媒体服务器（可选，仅用于跳转链接）
# EMBY_URL=http://192.168.1.10:8096
# JELLYFIN_URL=http://192.168.1.10:8096
# AUDIOBOOKSHELF_URL=http://192.168.1.10:13378
