# ============================================================
# NASPilot 部署配置（配合 docker-compose.deploy.yml 使用）
#
#   1. 复制本文件为 .env
#   2. 改 SECRET_KEY（必填）
#   3. docker compose -f docker-compose.deploy.yml up -d --build
# ============================================================

# ── 必填 ────────────────────────────────────────────────────
# 生成方式： openssl rand -hex 32
SECRET_KEY=change-me-please-generate-with-openssl-rand-hex-32
# 首次启动创建的管理员密码；留空则随机生成并写入日志
FIRST_ADMIN_PASSWORD=admin123

# ── 基础 ────────────────────────────────────────────────────
NASPILOT_PORT=8082
NASPILOT_VERSION=1.1.0-media
# 是否在镜像里装 nodejs（约 +280MB）。仅当 yt-dlp 需要 JS 运行时才打开。
NASPILOT_WITH_NODE=false
NASPILOT_DATA=./data
TZ=Asia/Shanghai
LOG_LEVEL=INFO

# ── 媒体目录（宿主机路径）──────────────────────────────────
# 只用一个根目录，容器内会自动使用它的 Video/ 与 Audio/ 子目录：
#   <这里>/Video/youtube/<频道>/...mp4
#   <这里>/Audio/podcast/<播客>/...mp3
# NAS 上建议改成绝对路径，例如 /volume1/media
NAS_MEDIA_ROOT=./data/media

# ── 媒体下载中心（全部可选，默认值见下，按需取消注释）──────
# MEDIA_DEFAULT_VIDEO_HEIGHT=1080   # 默认 480；0 = 原画
# MEDIA_MAX_CONCURRENT=2
# MEDIA_MAX_PER_SYNC=20
# MEDIA_SCAN_LIMIT=100

# ── 网络 / 代理（可选）─────────────────────────────────────
# 订阅「出网方式=使用系统默认」时用这个代理。
# 桥接网络下宿主机地址是 host.docker.internal；host 网络下用 127.0.0.1
# MEDIA_PROXY_URL=http://host.docker.internal:7890

# ── 媒体服务器（可选，仅用于「打开媒体库」跳转）────────────
# EMBY_URL=http://192.168.1.10:8096
# JELLYFIN_URL=http://192.168.1.10:8096
# AUDIOBOOKSHELF_URL=http://192.168.1.10:13378

# ── 可选挂载 ────────────────────────────────────────────────
# DOCKER_SOCK=/var/run/docker.sock
# NASPILOT_SCRIPTS=./scripts
# MEDIA_COOKIES_HOST=./data/cookies.txt

# ── 可选：VPN sidecar（gluetun）────────────────────────────
# VPN_SERVICE_PROVIDER=private internet access
# VPN_USER=
# VPN_PASSWORD=
# VPN_REGION=Netherlands
